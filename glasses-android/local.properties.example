# Copy to local.properties (git-ignored) and adjust.
sdk.dir=C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk

# Meta Wearables DAT credentials.
# In Developer Mode on the phone, "0" is correct for both.
# For production, take them from the Meta Wearables Developer Center
# (project > Configuration tab).
mwdat.applicationId=0
mwdat.clientToken=0

# Segmentation API (SAM 3). Token: run `make gpu-token`, or take the part after #token= in the webcam link.
# Keep it secret; local.properties is git-ignored.
segment.url=https://65-108-32-171.sslip.io/segment
segment.token=PASTE_TOKEN_HERE

# Where captured photos get POSTed (see PhotoSink.kt). Emulator -> host PC is 10.0.2.2.
backend.url=http://10.0.2.2:8000/upload
